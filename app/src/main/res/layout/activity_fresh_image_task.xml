<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fresh_image_task_title"
                android:textAppearance="@style/Widget.MangaTranslator.CardTitle" />

            <TextView
                android:id="@+id/fresh_image_task_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/Widget.MangaTranslator.BodyMuted" />

            <Button
                android:id="@+id/fresh_image_task_pick_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/fresh_image_task_pick" />

            <Button
                android:id="@+id/fresh_image_task_translate_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/fresh_image_task_translate" />
        </LinearLayout>

        <ImageView
            android:id="@+id/fresh_image_task_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/preview_image"
            android:scaleType="fitCenter" />
    </LinearLayout>
</ScrollView>
